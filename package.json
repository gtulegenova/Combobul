{
  "name": "combobul-playwright-framework",
  "version": "0.1.0",
  "private": true,
  "description": "QA-focused Playwright framework for desktop and mobile workflows.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:desktop": "playwright test tests/desktop",
    "test:mobile": "playwright test tests/mobile",
    "test:list": "playwright test --list",
    "report:open": "playwright show-report",
    "qa:runner": "ts-node scripts/qa-runner.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
