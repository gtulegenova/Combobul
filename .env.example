# Required app/environment configuration
BASE_URL=https://your-app-url.example.com

# Auth credentials (never commit real values)
QA_USER_EMAIL=qa.user@example.com
QA_USER_PASSWORD=replace-me

# Optional execution controls
HEADLESS=true
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAV_TIMEOUT_MS=30000
TIMEZONE=UTC

# Optional filtering
# TAGS=@smoke|@desktop
# BROWSERS=desktop-chromium,mobile-webkit
