# Required app/environment configuration
BASE_URL=https://your-app-url.example.com

# Optional named environments for the QA runner (--env <name> -> BASE_URL_<NAME>)
# BASE_URL_STAGING=https://staging.your-app-url.example.com
# BASE_URL_PROD=https://your-app-url.example.com

# Auth credentials (never commit real values)
QA_USER_EMAIL=qa.user@example.com
QA_USER_PASSWORD=replace-me
QA_MFA_CODE=
# Optional: auto-fetch latest MFA from Ghost Inspector inbox page
# QA_MFA_INBOX_URL=https://email.ghostinspector.com/qatestautomation/latest

# Optional execution controls
HEADLESS=true
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAV_TIMEOUT_MS=30000
TIMEZONE=UTC

# Optional filtering
# TAGS=@smoke|@desktop
# BROWSERS=desktop-chromium,mobile-webkit
